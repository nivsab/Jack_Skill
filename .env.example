# בחר ספק LLM: openai / anthropic / gemini
JACK_LLM_PROVIDER=openai

# הכנס רק את המפתח של הספק שבחרת
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# אופציונלי — דרוס את שם המודל (יש ברירות מחדל)
# JACK_OPENAI_MODEL=gpt-4o
# JACK_ANTHROPIC_MODEL=claude-sonnet-4-6
# JACK_GEMINI_MODEL=gemini-1.5-pro

# שלב 3 — Supabase RAG cache
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJ...   # anon key מ-Supabase → Settings → API

# שלב 4 — YouTube (אופציונלי)
# בלי מפתח זה: DuckDuckGo ישמש כ-fallback אוטומטי (ללא API key)
# עם מפתח: תוצאות YouTube רשמיות ואמינות יותר
# קבל מפתח: console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# אופטימיזציה — ניתוב לוקאלי עם Ollama (חוסך קריאות API לענן לכל הודעה)
# דורש: ollama pull llama3.2:3b && pip install langchain-ollama
# ללא הגדרה — הראוטר משתמש בספק הענן הרגיל
# JACK_ROUTER_PROVIDER=ollama
# JACK_OLLAMA_MODEL=llama3.2:3b
